# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/fitness_tracker
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fitness_tracker
MONGO_URI=mongodb://127.0.0.1:27017/fitness_tracker

# Port the Express server will listen on (not required for the DB layer itself,
# but included so this file can double as your project's main .env)
PORT=5000
